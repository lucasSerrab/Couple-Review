# Tudo aqui é OPCIONAL. Sem nenhuma chave o app funciona.
# Para usar, copie este arquivo para .env.local e preencha só o que quiser.

# Busca melhor (acha animes, traz sinopse em português). Chave gratuita em themoviedb.org > Settings > API.
TMDB_API_KEY=

# Transcrição e resumo por IA no lugar do reconhecimento de voz do navegador.
# A do Gemini tem plano gratuito (aistudio.google.com). A da OpenAI é paga.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Onde ficam o banco, os áudios e as fotos (padrão: pasta "data" do projeto).
# DATALUG_DATA=
